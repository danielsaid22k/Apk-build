ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TELEGRAM_HEARTBEAT_SECONDS=60
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_DELAY_SECONDS=3
TELEGRAM_COLLECTION_RECEIPT=true

POLL_INTERVAL_SECONDS=100

APPROVAL_BRIDGE_HOST=127.0.0.1
APPROVAL_BRIDGE_PORT=8765
APPROVAL_BRIDGE_BASE_URL=http://127.0.0.1:8765

AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_SECONDS=3600
AUTO_BACKUP_KEEP=20

# URL HTTPS pública que encaminha para 127.0.0.1:8765
APPROVAL_BRIDGE_PUBLIC_URL=

# Solana RPC — use CONFIGURE_SOLANA_RPC.bat
# A chave permanece no PC e não é enviada para o navegador da Phantom.
HELIUS_API_KEY=
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=
SOLANA_RPC_ENABLE_HELIUS_BETA_FALLBACK=false
SOLANA_RPC_TIMEOUT_SECONDS=20
SOLANA_RPC_VALIDATE_ON_START=true


# v7 — scanner inteligente / cache
TOKEN_METADATA_CACHE_TTL_SECONDS=21600
SOLANA_RPC_FAILURE_COOLDOWN_SECONDS=30
